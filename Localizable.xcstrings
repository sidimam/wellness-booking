    "Tocca una lezione per vedere lo scheduler e attivare la prenotazione automatica; tocca il cerchio per selezionarne più di una.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Kurs, um den Zeitplaner zu sehen und die automatische Buchung zu aktivieren; tippe auf den Kreis, um mehrere auszuwählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a class to see the scheduler and enable automatic booking; tap the circle to select more than one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una clase para ver el planificador y activar la reserva automática; toca el círculo para seleccionar varias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un cours pour voir le planificateur et activer la réservation automatique ; touchez le cercle pour en sélectionner plusieurs."
          }
        }
      }
    },
    "URL centro (es. wellnesstown)": {
