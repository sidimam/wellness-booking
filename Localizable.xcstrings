    "Usa email e password dell'account Technogym mywellness con cui prenoti al centro.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende E-Mail und Passwort des Technogym-mywellness-Kontos, mit dem du im Studio buchst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the email and password of the Technogym mywellness account you book with at the club."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el correo y la contraseña de la cuenta Technogym mywellness con la que reservas en el centro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez l'e-mail et le mot de passe du compte Technogym mywellness avec lequel vous réservez au club."
          }
        }
      }
    },
    "Vai in Lezioni, seleziona le classi che ti interessano e tocca Aggiungi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehe zu Kurse, wähle die gewünschten aus und tippe auf Hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Classes, select the ones you want and tap Add."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a Clases, selecciona las que te interesan y toca Añadir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez dans Cours, sélectionnez ceux qui vous intéressent et touchez Ajouter."
          }
        }
      }
    },
