          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ is full: watching is active, I'll book as soon as a spot opens up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ está llena: observación activa, reservaré en cuanto se libere una plaza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ est complet : observation active, je réserve dès qu'une place se libère."
          }
