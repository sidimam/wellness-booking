    "Scegli le lezioni che ti interessano: l'app le prenota da sola all'apertura delle prenotazioni, anche alle 5 del mattino.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Kurse, die dich interessieren: die App bucht sie bei Öffnung der Buchung von selbst, auch um 5 Uhr morgens."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the classes you want: the app books them on its own when booking opens, even at 5 in the morning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las clases que te interesan: la app las reserva sola al abrir las reservas, incluso a las 5 de la mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les cours qui vous intéressent : l'app les réserve seule à l'ouverture des réservations, même à 5 h du matin."
          }
        }
      }
    },
    "Scheduler": {
      "localizations": {
