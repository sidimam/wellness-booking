    "%1$@ %2$@ è piena: osservazione attiva, prenoto appena si libera un posto.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ ist voll: Beobachtung aktiv, ich buche, sobald ein Platz frei wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ is full: watching is active, I'll book as soon as a spot opens up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ está llena: observación activa, reservaré en cuanto se libere una plaza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ est complet : observation active, je réserve dès qu'une place se libère."
          }
        }
      }
    },
