    "iOS non esegue l'app in background a orari precisi: tieni l'app aperta all'orario di apertura.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS führt die App im Hintergrund nicht zu exakten Zeiten aus: App zur Öffnungszeit geöffnet lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS doesn't run the app in the background at exact times: keep the app open at opening time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no ejecuta la app en segundo plano a horas exactas: mantén la app abierta a la hora de apertura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS n'exécute pas l'app en arrière-plan à heure fixe : gardez l'app ouverte à l'heure d'ouverture."
          }
        }
      }
    },
    "subito (apertura già avvenuta)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "sofort (bereits geöffnet)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "right away (already open)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "de inmediato (ya abierta)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "tout de suite (déjà ouvert)"
          }
        }
      }
    }
  },
  "version": "1.0"
