    "Ora e anticipo in millisecondi si regolano in Altro → Scheduler.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uhrzeit und Vorlauf in Millisekunden stellst du unter Mehr → Zeitplaner ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time and lead time in milliseconds are set in More → Scheduler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora y la antelación en milisegundos se ajustan en Más → Planificador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'heure et l'avance en millisecondes se règlent dans Plus → Planificateur."
          }
        }
      }
    },
